{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://canchalibre-backend-v2-test.onrender.com/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://canchalibre-backend-v2-test.onrender.com/auth/:path*"
    }
  ],
  "headers": [
    {
      "source": "/auth/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
